{
  "name": "@omnifield/brainer-harness",
  "version": "0.2.0",
  "description": "Агент-харнесс brainer как обвес baser: роль-рамка (architect/owner/layer) + хуки-гейты + сид роль-модели.",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "harness"
  ],
  "scripts": {
    "build": "node test/validate.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "biome check .",
    "pack": "node scripts/pack.mjs"
  },
  "baser": {
    "formVersion": 3,
    "source": {
      "id": "brainer/harness",
      "title": "Агент-харнесс: роль впаяна в сессию",
      "contentRoot": "harness"
    },
    "layout": [
      {
        "src": "roles/architect.md",
        "dest": ".claude/agents/architect.md",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "roles/owner.md",
        "dest": ".claude/agents/owner.md",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "roles/layer.md",
        "dest": ".claude/agents/layer.md",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "shared-policy.md",
        "dest": ".claude/agents/shared-policy.md",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "helpers/research.md",
        "dest": ".claude/agents/research.md",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "helpers/routine.md",
        "dest": ".claude/agents/routine.md",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "hooks/harness-config.mjs",
        "dest": ".claude/hooks/harness-config.mjs",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "hooks/scope-resolve.mjs",
        "dest": ".claude/hooks/scope-resolve.mjs",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "hooks/scope-identity.mjs",
        "dest": ".claude/hooks/scope-identity.mjs",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "hooks/git-gate.mjs",
        "dest": ".claude/hooks/git-gate.mjs",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "hooks/main-session-marker.mjs",
        "dest": ".claude/hooks/main-session-marker.mjs",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "hooks/harness-doctor.mjs",
        "dest": ".claude/hooks/harness-doctor.mjs",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "hooks/governance.mjs",
        "dest": ".claude/hooks/governance.mjs",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "gitignore.claude",
        "dest": ".claude/.gitignore",
        "render": false,
        "class": "regenerated"
      },
      {
        "src": "settings.hooks.json",
        "dest": ".claude/settings.json",
        "render": false,
        "class": "placed-once"
      },
      {
        "src": "harness.config.example.yaml",
        "dest": ".omnifield/harness.yaml",
        "render": false,
        "class": "placed-once"
      }
    ]
  }
}
